@startuml
!pragma layout smetana
skinparam backgroundColor white
skinparam defaultFontName Arial
skinparam defaultFontSize 15
skinparam shadowing false
skinparam roundcorner 0
skinparam ArrowColor #2459D9
skinparam classBackgroundColor #F4F7FC
skinparam classBorderColor #2459D9
skinparam packageStyle rectangle
hide methods
entity "categorias" as categorias {
 PK id : int4
 nome : varchar
 ativo : bool
}
entity "produtos" as produtos {
 PK id : int4
 nome : varchar
 preco : numeric
 FK id_categoria : int4
 ativo : bool
 FK criado_por : int4
 imagem : bytea
}
entity "estoque" as estoque {
 PK FK id_produto : int4
 quantidade : int4
 estoque_minimo : int4
 alerta_ativo : bool
 episodio_alerta : int8
}
entity "movimentos_estoque" as movimentos_estoque {
 PK id : int8
 FK id_produto : int4
 tipo : varchar
 saldo : int4
 FK id_usuario : int4
 FK id_cliente : int4
 FK id_pedido : int4
}
categorias |o--o{ produtos : id_categoria
produtos ||--o| estoque : id_produto
produtos ||--o{ movimentos_estoque : id_produto
note "Campos estruturais do módulo.\nFK externas: clientes.id, pedidos.id, usuarios.id\nCampos completos no DICIONARIO_BANCO.md.\nCardinalidade geral 1 para muitos; PK compartilhada limita a 1 para 0 ou 1." as legenda

@enduml
